# GitHub Pages frontend: deployed Vercel API origin, without a trailing slash.
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Vercel serverless backend / Supabase privileged server key (never expose with VITE_ prefix).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy fallback, only if the project has not migrated to Supabase secret keys:
SUPABASE_SERVICE_ROLE_KEY=
RIOT_API_KEY=
# At least 32 random characters. Used only by the backend to encrypt DB settings.
SETTINGS_ENCRYPTION_KEY=
OPGG_SCRAPING_ENABLED=true
TOURNAMENT_API_ENABLED=false

# Temporary migration fallback. Remove after Supabase Auth login is deployed.
HUH_ADMIN_TOKEN=
ALLOWED_ORIGINS=https://wnstj999.github.io,http://localhost:5173,http://localhost:4173
