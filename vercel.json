{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/tournament-session",
      "destination": "/api/matches?action=tournament-session"
    },
    {
      "source": "/api/tournament-callback",
      "destination": "/api/tournaments?action=tournament-callback"
    },
    {
      "source": "/api/tournaments/:id",
      "destination": "/api/tournaments?id=:id"
    },
    {
      "source": "/api/custom-teams/:id",
      "destination": "/api/custom-teams?id=:id"
    },
    {
      "source": "/api/matches/:id",
      "destination": "/api/matches?id=:id"
    },
    {
      "source": "/api/players/:id",
      "destination": "/api/players?id=:id"
    },
    {
      "source": "/api/match-participants/:id",
      "destination": "/api/match-participants?id=:id"
    },
    {
      "source": "/HUH/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-HUH-Access-Token"
        }
      ]
    }
  ]
}
